# Copy to .env and point at any Ethereum mainnet RPC, for example:
#   https://eth-mainnet.g.alchemy.com/v2/<your-api-key>
# Fork tests under test/fork are skipped when this is unset.
MAINNET_RPC_URL=

# Deploy target for script/DeployForwardHook.s.sol.
#   anvil   deploys a fresh PoolManager, for an empty local chain
#   fork    expects the canonical PoolManager already in state
#   testnet expects the canonical PoolManager for that chain id
TARGET=anvil

# Root authority on the hook. Must be set explicitly, msg.sender is the CREATE2 proxy.
HOOK_ADMIN=
# Holds UNDERWRITER_ROLE, commits capabilities and prices agents.
UNDERWRITER=
# Fee for agents holding no capability, in hundredths of a bip.
DEFAULT_FEE=3000
# Overrides the canonical PoolManager lookup for fork and testnet targets.
POOL_MANAGER=

# Block to fork from. Defaults to 25861513, the block containing
# 0x2521bf732e6c502d3047bebda665b291b054d7d3e60eeacb90403a947cba7519.
# Requires an archive RPC; set 0 to fork from the latest block instead.
FORK_BLOCK=25861513

# Block for the arbitrage program suite, the trader's follow up trade.
ARB_FORK_BLOCK=25893132
